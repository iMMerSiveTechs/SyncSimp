# ===========================================
# SyncSimp Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# Firebase Configuration (required)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:ios:xxxxxxxxxxxx

# Backend Configuration
EXPO_PUBLIC_VIBECODE_BACKEND_URL=http://localhost:3000
EXPO_PUBLIC_VIBECODE_PROJECT_ID=syncsimp

# RevenueCat (optional - for monetization)
EXPO_PUBLIC_VIBECODE_REVENUECAT_APPLE_KEY=appl_your_key_here

# Backend Server
PORT=3000
NODE_ENV=development
DATABASE_URL=file:dev.db
BETTER_AUTH_SECRET=your_32_char_secret_here_change_me
BACKEND_URL=http://localhost:3000

# CORS (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Debug scripts (only needed for development)
REVENUECAT_SECRET_KEY=sk_your_secret_key_here
